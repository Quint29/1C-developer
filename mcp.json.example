{
  "mcpServers": {
    "1c-platform-bsl-context": {
      "type": "stdio",
      "command": "java",
      "args": [
        "-Dfile.encoding=UTF-8",
        "-jar",
        "__KIT_ROOT__\\bin\\mcp-bsl-context-0.3.2.jar",
        "--platform-path",
        "__PLATFORM_PATH__"
      ]
    },
    "v8std": {
      "url": "https://ai.v8std.ru/mcp"
    },
    "lsp-bsl-bridge": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "exec",
        "-i",
        "1c-dev-mcp-bsl-rlm",
        "mcp-lsp-bridge"
      ]
    },
    "yaxunit-runner": {
      "type": "stdio",
      "command": "java",
      "args": [
        "-Dfile.encoding=UTF-8",
        "-jar",
        "__KIT_ROOT__\\bin\\mcp-yaxunit-runner-0.5.2.jar"
      ]
    }
  }
}
